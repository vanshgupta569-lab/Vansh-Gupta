// FILE: scripts/buildInstantListings.mts
//
//   npm run search:instant
//
// THE INSTANT-ANSWER LIST (`docs/NAV_SEARCH_SPEC.md` §4.6; build step 9 job
// 9.2's LOCAL half). The spec: "The 200 largest listings ship with the dialog
// chunk (≤ 20KB gzip) so common names answer with no network call." The cloud
// run could not build it, because it has to come from the real company set.
//
// WHY IT IS NOT RANKED BY SIZE.
//
// "The largest" needs one measure of size across the whole set, and the set
// trades in eleven currencies. The screener table carries each company's market
// capitalisation in its OWN currency, so sorting those numbers ranks by the
// size of the currency unit and not by the size of the company: ranked that
// way, Samsung (KRW 1,264,886,021,026,800) and TSMC come out above every US
// company in the set. `SCREENER_SPEC` rule 6 allows a converted value only
// through an explicit base-currency setting with the FX date, and there is no
// rate here to convert with.
//
// So this does not rank. It takes EVERY listing the set holds, in name order,
// which is a defensible order a reader can check, and the file says what it is.
// That costs nothing today: 178 listings are 2.8KB gzipped against a 20KB
// budget, so there is nothing to choose between — the cut to 200 only starts to
// matter when the universe passes 200, and by then it needs the base-currency
// setting rule 6 describes. Recorded in `DATA_CONSTRAINTS.md`.
//
// A size ranking that is really a currency ranking would be worse than no
// ranking, because it looks like an answer (standing decision 3).
import fs from 'node:fs';
import path from 'node:path';
import zlib from 'node:zlib';
import { fileURLToPath } from 'node:url';

const HERE = path.dirname(fileURLToPath(import.meta.url));
const REPO = path.resolve(HERE, '..').split(path.sep).join('/');
const TABLE = path.join(REPO, 'verify', 'screener-table.json');
const OUT = path.join(REPO, 'src', 'data', 'instantListings.ts');
const WANT = 200;
const BUDGET_KB = 20;

if (!fs.existsSync(TABLE)) {
  console.log(`no screener table at ${TABLE} — run npm run screener:table first`);
  process.exit(1);
}

const raw = JSON.parse(fs.readFileSync(TABLE, 'utf8'));
const rows: any[] = Array.isArray(raw) ? raw : raw.rows || raw.companies || [];

// The currencies in play, reported so the reason above can be checked rather
// than taken on trust.
const currencies = new Set(rows.map((r) => String(r.currency || '')).filter(Boolean));

const listings = rows
  .map((r) => ({
    ticker: String(r.ticker),
    name: String(r.name),
    exchange: String(r.exchange || ''),
  }))
  .sort((a, b) => a.name.localeCompare(b.name, 'en', { sensitivity: 'base' }) || a.ticker.localeCompare(b.ticker))
  .slice(0, WANT);

const body = JSON.stringify(listings, null, 0);
const built = new Date().toISOString().slice(0, 10);

const file = `// FILE: src/data/instantListings.ts
//
// GENERATED by scripts/buildInstantListings.mts (npm run search:instant).
// Do not edit by hand.
//
// The listings the search palette can answer from with NO NETWORK CALL
// (\`docs/NAV_SEARCH_SPEC.md\` §4.6). Ticker, name and exchange only — all a
// search row needs. No figures: 93 rows of the table behind this carry
// vendor-sourced data this site is not licensed to redistribute
// (\`SCREENER_SPEC\` rule 11), and answering a keystroke does not need them.
//
// NOT RANKED BY SIZE, and the builder says why at length: the set trades in
// ${currencies.size} currencies and each market capitalisation is in its own, so sorting
// them ranks currency units rather than companies, and \`SCREENER_SPEC\` rule 6
// allows a conversion only with an explicit base currency and FX date. Every
// listing the set holds is here instead, in name order.
//
// Built ${built} from ${rows.length} companies: ${listings.length} listings.

export interface InstantListing {
  ticker: string;
  name: string;
  exchange: string;
}

/** The spec's figure. The list is shorter wherever the set is smaller. */
export const INSTANT_LISTINGS_WANTED = ${WANT};

/** Where this came from, for the palette's own "no network call" claim. */
export const INSTANT_LISTINGS_BUILT = '${built}';

export const INSTANT_LISTINGS: InstantListing[] = ${body};

export default INSTANT_LISTINGS;
`;

fs.writeFileSync(OUT, file.split('\n').join('\r\n'));

const gz = zlib.gzipSync(Buffer.from(body, 'utf8')).length / 1024;
console.log(
  `instant listings: ${listings.length} of the ${WANT} the spec allows, from ${rows.length} companies in the set`
);
console.log(
  `  not ranked by size: ${currencies.size} currencies in the set and no FX date to convert with, so the order is the name A-Z`
);
console.log(`  ${gz.toFixed(1)}KB gzipped against the ${BUDGET_KB}KB budget — ${gz <= BUDGET_KB ? 'inside' : 'OVER'}`);
if (gz > BUDGET_KB) {
  console.log(
    '  OVER BUDGET: the cut to the largest 200 now matters, and it needs the base-currency setting of SCREENER rule 6.'
  );
}
console.log(`  first three by name: ${listings.slice(0, 3).map((l) => `${l.ticker} (${l.name})`).join(', ')}`);
console.log(`  written to ${OUT}`);
